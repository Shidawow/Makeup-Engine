{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".test-dist",
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "tests/**/*.d.ts"]
}
