{
  "name": "makeup-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:browser": "vitest run",
    "build:training-dataset": "node scripts/build-training-dataset.mjs",
    "mediapipe:prepare": "node scripts/prepare-mediapipe-assets.mjs --download-model",
    "mediapipe:check": "node scripts/prepare-mediapipe-assets.mjs --check",
    "training:preflight": "node scripts/training-preflight.mjs",
    "training:baseline": "node scripts/train-baseline-segmentation.mjs",
    "training:image-conditioned": "node scripts/train-image-conditioned-segmentation.mjs",
    "training:lightweight": "node scripts/train-lightweight-segmentation.mjs",
    "training:export": "node scripts/export-model-package.mjs",
    "images:import": "node scripts/import-source-images.mjs",
    "user-app:browser-qa": "node scripts/user-app-browser-qa.mjs",
    "project:status": "node scripts/project-status.mjs",
    "project:context": "node scripts/context-pack.mjs",
    "lint": "npm run typecheck",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
